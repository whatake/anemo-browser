{
  "name": "anemo",
  "productName": "Anemo",
  "version": "0.1.0",
  "private": true,
  "description": "Anemo — a privacy-first, keyboard-driven, local-AI desktop browser",
  "main": "dist/main/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "smoke:db": "tsx tests/database.smoke.ts"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "better-sqlite3": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
